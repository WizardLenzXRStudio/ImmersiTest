# =============================================================================
#  XR Test Lab — environment
#  Wizardlenz XR Studio
#
#  Copy to .env (or set these in the Hostinger panel) and adjust.
#  Nothing here is required for local development: `npm start` runs in local
#  mode on loopback with sane defaults.
# =============================================================================

# ---- mode -------------------------------------------------------------------
# local  : development / offline instance. SQLite dashboard mounted, data
#          persists in data/, server binds to 127.0.0.1.
# hosted : the public service. No database, no accounts, no permanent report
#          storage — uploads become short-lived in-memory analyses.
XRLAB_MODE=hosted

# ---- network ----------------------------------------------------------------
PORT=3000

# Interface to bind. Hosted runs behind the Hostinger reverse proxy, so 0.0.0.0
# is correct there. Local mode defaults to 127.0.0.1 and should stay that way.
XRLAB_HOST=0.0.0.0

# The public HTTPS address of the service. REQUIRED in hosted mode.
# This is the URL the Unity package opens in the user's browser, so a wrong
# value produces unreachable report links. Hosted mode refuses to start if this
# is not HTTPS.
XRLAB_PUBLIC_URL=https://immersitest.wizardlenzxrstudio.com

# Extra browser origins allowed to call the API cross-origin, comma separated.
# The origin of XRLAB_PUBLIC_URL is always allowed and need not be listed.
# Leave empty unless a separate front-end domain calls this API.
XRLAB_ALLOWED_ORIGINS=

# Proxy hops to trust when reading the client IP for rate limiting.
# Hostinger terminates TLS in front of the app, so 1 is correct.
XRLAB_TRUST_PROXY=1

# Send HSTS. Enable only once the domain is HTTPS-only.
XRLAB_HSTS=true

# ---- temporary analysis sessions --------------------------------------------
# How long an uploaded report stays available before it is deleted.
# Expiry is absolute from upload and is never extended by viewing the report.
XRLAB_SESSION_TTL_MINUTES=60

# Reports that may share one analysis (enables comparison and trend).
XRLAB_SESSION_MAX_REPORTS=25

# Ceilings that bound memory use. Oldest analyses are evicted beyond them.
XRLAB_MAX_SESSIONS=1000
XRLAB_MAX_TOTAL_BYTES=268435456

# How often expired analyses are swept, in seconds.
XRLAB_SWEEP_SECONDS=60

# ---- limits -----------------------------------------------------------------
# Maximum size of a single profiler upload.
XRLAB_UPLOAD_LIMIT=4mb

# Fixed-window rate limit on upload endpoints, per client IP.
XRLAB_RATE_LIMIT=true
XRLAB_RATE_WINDOW_SECONDS=60
XRLAB_RATE_MAX=30

# ---- local mode only ---------------------------------------------------------
# Override the SQLite file location.
# XRLAB_DB=/absolute/path/to/xr-test-lab.db

# Body limit for the local bulk-import endpoint (many reports per request).
# JSON_BODY_LIMIT=25mb

# ---- development escape hatch -------------------------------------------------
# Allows hosted mode to start on a plain-HTTP XRLAB_PUBLIC_URL.
# NEVER set this on the real deployment.
# XRLAB_ALLOW_INSECURE=false
